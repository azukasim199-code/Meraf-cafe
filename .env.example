# APP_URL / PUBLIC_APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PUBLIC_APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL / Supabase connection string (Optional - falls back to embedded JSON file database)
